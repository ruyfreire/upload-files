# Variáveis da API NestJS — copie para .env após bootstrap ou deploy-cfn
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET=csv-uploads
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:csv-upload-events
INGEST_QUEUE_URL=
DYNAMODB_TABLE=CsvRecords
SECRET_NAME=study/webhook
LOG_GROUP_NAME=/study/csv-pipeline

PORT=3000

KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=csv.processed
KAFKA_GROUP_ID=csv-processed-api
